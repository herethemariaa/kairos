        <!--aquecimento global -->
        <section
          class="tema"
          id="aquecimento-global"
          aria-labelledby="t-aquecimento"
        >
          <h2 id="t-aquecimento">Aquecimento global</h2>
          <p>Dados e estudos sobre a temperatura do planeta.</p>
          <div class="lista-cards">
            <article class="card">
              <img
                src="https://jornal.usp.br/wp-content/uploads/2026/09/20260909_manguezal.jpg"
                alt="Manguezais"
              />
              <div class="card-corpo">
                <span class="categoria">Ciência</span>
                <h3>
                  Aquecimento global aumenta emissão de metano mesmo em solos de
                  mangue intocadosal
                </h3>
                <p class="meta">
                  <time datetime="2026-11-09">17/09/2026</time>
                  por <span>Amanda Yoshizakir</span>, <span>Jornal da USP</span>
                </p>
                <p>
                  Experimento simulou condições de elevação de temperatura e
                  registrou mudanças no funcionamento do solo que alteraram a
                  decomposição da matéria orgânica em manguezais
                </p>
                <a
                  class="ler-mais"
                  href="https://jornal.usp.br/ciencias/aquecimento-global-aumenta-emissao-de-metano-mesmo-em-solos-de-mangue-intocados/"
                  target="_blank"
                  rel="noopener noreferrer"
                  >Ler mais</a
                >
              </div>
            </article>
            <article class="card">
              <img
                src="https://classic.exame.com/wp-content/uploads/2023/09/onda-de-calor-e1699639915557.jpg?ims=750x/filters:quality(85):format(webp)"
                alt="Termômetro indicando a temperatura elevada"
              />
              <div class="card-corpo">
                <span class="categoria">Pesquisa</span>
                <h3>
                  Brasil pode enfrentar calor extremo por um terço do ano até
                  2075
                </h3>
                <p class="meta">
                  <time datetime="2026-11-08">12/06/2026</time>
                  por <span>Sofia Schuck</span>, <span>Exame</span>
                </p>
                <p>
                  Projeção da i4sea revela um salto de 6 para 127 dias de calor
                  extremo por ano e aumento de 1,7°C na temperatura máxima média
                  do país
                </p>
                <a
                  class="ler-mais"
                  href="https://exame.com/esg/brasil-pode-enfrentar-calor-extremo-por-um-terco-do-ano-ate-2075/"
                  target="_blank"
                  rel="noopener noreferrer"
                  >Ler mais</a
                >
              </div>
            </article>
          </div>
        </section>

